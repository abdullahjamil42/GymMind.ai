# ===================================
# GymMind.ai Environment Variables
# ===================================
# Copy this file to .env.local for development
# NEVER commit .env.local to version control

# ===================================
# Application
# ===================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GymMind.ai

# ===================================
# Authentication (NextAuth.js)
# ===================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# ===================================
# Database (MongoDB)
# ===================================
# Local: mongodb://localhost:27017/gymmind
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/gymmind
MONGODB_URI=mongodb://localhost:27017/gymmind

# ===================================
# AI Services - LLM APIs
# ===================================
# OpenAI API (Primary LLM)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Google Gemini API (Alternative LLM)
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_GEMINI_MODEL=gemini-1.5-pro

# Anthropic Claude API (Alternative LLM)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Default LLM Provider: openai | gemini | anthropic
DEFAULT_LLM_PROVIDER=openai

# ===================================
# Nutrition APIs
# ===================================
# USDA FoodData Central API
USDA_API_KEY=your-usda-api-key-here

# Nutritionix API (optional, for enhanced food data)
NUTRITIONIX_APP_ID=your-nutritionix-app-id
NUTRITIONIX_API_KEY=your-nutritionix-api-key

# ===================================
# Rate Limiting & Security
# ===================================
# Maximum API calls per user per day
MAX_AI_CALLS_PER_DAY=100
MAX_FORM_CHECK_CALLS_PER_DAY=10

# ===================================
# Feature Flags
# ===================================
ENABLE_FORM_CHECKER=true
ENABLE_ROUTINE_ANALYZER=true
ENABLE_CHATBOT=true

# ===================================
# Development Settings
# ===================================
# Set to 'true' to enable debug logging
DEBUG_MODE=false
