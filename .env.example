# ===========================================
# GymMind.ai Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# ===========================================
# Database Configuration
# ===========================================
# MongoDB connection string
# Local: mongodb://localhost:27017/gymmind
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/gymmind
MONGODB_URI=

# ===========================================
# Authentication (NextAuth.js)
# ===========================================
# Secret key for JWT signing (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=

# Base URL of your application
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# AI Services
# ===========================================
# Google Gemini API Key
# Get yours at: https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# ===========================================
# Optional: Analytics & Monitoring
# ===========================================
# Vercel Analytics (automatically included in Vercel deployments)
# VERCEL_ANALYTICS_ID=

# ===========================================
# Development Settings
# ===========================================
# Set to 'development' for dev mode, 'production' for prod
NODE_ENV=development
